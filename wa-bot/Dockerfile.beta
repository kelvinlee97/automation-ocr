# Dockerfile for local beta testing
# For local testing on Apple Container (without Chromium, only running Admin background)
# Usage (in the wa-bot/ directory):
#   container build -t wa-bot:beta -f Dockerfile.beta .
#   container run --rm -p 3000:3000 -v $(pwd):/app wa-bot:beta

FROM node:20-slim

WORKDIR /app

# Copy package.json and use layer caching
# (If package.json has not changed, this layer of cache hits, and there is no need to re-npm install)
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev

# Copy application code
COPY . .

# Create /config → /app/config symbolic link (compatible with relative paths within code)
RUN ln -s /app/config /config

# Exposed port (Express default 3000)
EXPOSE 3000

CMD ["node", "index.js"]
