# 本地 Beta 测试专用 Dockerfile
# 用于 Apple Container 本地测试（不含 Chromium，只运行 Admin 后台）
# 使用方法（在 wa-bot/ 目录下）：
#   container build -t wa-bot:beta -f Dockerfile.beta .
#   container run --rm -p 3000:3000 -v $(pwd):/app wa-bot:beta

FROM node:20-slim

WORKDIR /app

# 复制 package.json，利用 layer 缓存
# （如果 package.json 没变，这层缓存命中，不需要重新 npm install）
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev

# 复制应用代码
COPY . .

# 创建 /config → /app/config 符号链接（兼容代码内相对路径）
RUN ln -s /app/config /config

# 暴露端口（Express 默认 3000）
EXPOSE 3000

CMD ["node", "index.js"]
