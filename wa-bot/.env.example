# ════════════════════════════════════════════════════════════════════════════
# Environment variable configuration template
# ════════════════════════════════════════════════════════════════════════════
#
# Instructions for use:
#   1. Copy this file as .env: cp .env.example .env
#   2. Fill in the required fields
#   3. Select the corresponding configuration according to the operating environment (see below)
#
# Running environment comparison:
#   - Production (DO Docker Compose): fill in all required fields
#   - Local Beta (Apple Container): OPENAI_API_KEY and GITHUB_TOKEN can be left blank
#
# ════════════════════════════════════════════════════════════════════════════

# ──Required (required for production + local)─────────────────────────────────────────────

# Session signing key (required to prevent all users from being kicked out due to invalid cookie signature after restart)
# Generate command: openssl rand -hex 32
SESSION_SECRET=your_random_secret_here

# ──Required (manufacturing only)──────────────────────────────────────────────────────

# Domain name (required for production, used for Caddy automatic HTTPS; not required locally)
DOMAIN=your-domain.com

# OpenAI API Key (required for production receipt extraction; local beta can be left blank)
OPENAI_API_KEY=your_openai_api_key_here

# ── Optional ───────────────────────────────────────────────────────────────

# GitHub Token (Feedback → GitHub Issues integration, optional)
GITHUB_TOKEN=ghp_your_github_token_here

# Data directory (default: ./data)
#   - Production (docker-compose): injected by docker-compose.yml as /opt/claimflow/data
#   - Local Beta: Use default ./data
# DATA_DIR=/app/data

# ── Complete production configuration example ─────────────────────────────────────────────────────
# SESSION_SECRET=f937c7f5a32c4cfa9fb390e04178a00062dc226b380ba2471d6211efdfca6de4
# DOMAIN=kelvin.ink
# OPENAI_API_KEY=sk-...
# GITHUB_TOKEN=ghp_...
# DATA_DIR=/opt/claimflow/data

# ── Minimal local beta configuration example ────────────────────────────────────────────────
# SESSION_SECRET=any-random-hex-for-local-testing
# OPENAI_API_KEY=
# GITHUB_TOKEN=
