# ════════════════════════════════════════════════════════════════════════════
# 环境变量配置模板
# ════════════════════════════════════════════════════════════════════════════
#
# 使用说明：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 填写必填项
#   3. 根据运行环境选择对应的配置（见下方）
#
# 运行环境对照：
#   - 生产（DO Docker Compose）：填所有必填项
#   - 本地 Beta（Apple Container）：可留空 GEMINI_API_KEY 和 GITHUB_TOKEN
#
# ════════════════════════════════════════════════════════════════════════════

# ── 必填（生产 + 本地都需要）────────────────────────────────────────────────

# Session 签名密钥（必填，防止重启后 cookie 签名失效导致所有用户被踢出）
# 生成命令：openssl rand -hex 32
SESSION_SECRET=your_random_secret_here

# ── 必填（仅生产）────────────────────────────────────────────────────────────

# 域名（生产必填，用于 Caddy 自动 HTTPS；本地不需要）
DOMAIN=your-domain.com

# Gemini API Key（生产必填，收据 OCR 识别；本地 beta 可留空）
GEMINI_API_KEY=your_gemini_api_key_here

# ── 可选 ────────────────────────────────────────────────────────────────────────

# GitHub Token（Feedback → GitHub Issues 集成，可选）
GITHUB_TOKEN=ghp_your_github_token_here

# 数据目录（默认：./data）
#   - 生产（docker-compose）：由 docker-compose.yml 注入为 /opt/claimflow/data
#   - 本地 Beta：使用默认值 ./data
# DATA_DIR=/app/data

# ── 完整生产配置示例 ─────────────────────────────────────────────────────────
# SESSION_SECRET=f937c7f5a32c4cfa9fb390e04178a00062dc226b380ba2471d6211efdfca6de4
# DOMAIN=kelvin.ink
# GEMINI_API_KEY=AIza...
# GITHUB_TOKEN=ghp_...
# DATA_DIR=/opt/claimflow/data

# ── 最小本地 Beta 配置示例 ───────────────────────────────────────────────────
# SESSION_SECRET=any-random-hex-for-local-testing
# GEMINI_API_KEY=
# GITHUB_TOKEN=
